# Copy to .env.local or set environment variables. Never commit real values.
# Never put real keys in Git, screenshots or workflow exports.
BRIEFOPS_LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# To use OpenRouter, set BRIEFOPS_LLM_PROVIDER=openrouter instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# If omitted, a token is generated in data/automation-token.txt.
BRIEFOPS_AUTOMATION_TOKEN=

# Neon pooled URL for queries; direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BRIEFOPS_PUBLIC_DEMO=0
BRIEFOPS_LLM_DAILY_LIMIT=50
BRIEFOPS_WRITE_DAILY_LIMIT=300

# Optional private workspace. It MUST use a different database from the public demo.
# BRIEFOPS_LIVE_DATABASE_URL=
# BRIEFOPS_LIVE_DATABASE_URL_UNPOOLED=
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# BRIEFOPS_OWNER_EMAIL=
# BRIEFOPS_MAIL_BRIDGE_URL=
# BRIEFOPS_MAIL_BRIDGE_SECRET=
